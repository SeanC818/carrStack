  "css": "/* Teravera: restrained surfaces with cobalt accents. */\n:root:not(.dark) { --tv-canvas: #fafbfd; --tv-panel: #fff; --tv-side: #eef1f6; --tv-border: #dfe4ed; --tv-link: #0236ad; --tv-ink: #24314a; --tv-muted: #66738a; --tv-shadow: rgba(20,40,80,.045); }\n:root.dark { --tv-canvas: #0b1426; --tv-panel: #111e36; --tv-side: #0c1525; --tv-border: #253249; --tv-link: #9bbbfa; --tv-ink: #dce5f4; --tv-muted: #94a4be; --tv-shadow: rgba(0,0,0,.16); }\n[data-slot=\"sidebar-inner\"]::before { content: none !important; display: none !important; }\n[data-slot=\"sidebar\"], [data-slot=\"sidebar-inner\"] { background: var(--tv-side) !important; color: var(--tv-ink) !important; --foreground: var(--tv-ink); --muted-foreground: var(--tv-muted); }\n[data-slot=\"sidebar\"] [data-thread-item] { border-radius: 7px !important; }\n[data-slot=\"sidebar\"] svg.lucide { stroke-width: 1.6; }\n[data-chat-header] { background: var(--tv-panel) !important; border-bottom: 1px solid var(--tv-border) !important; }\n[data-chat-header]::after { content: \"TERAVERA\"; display: block; flex-shrink: 0; margin-left: auto; padding: 0 16px; color: var(--tv-link); font-size: 10px; font-weight: 650; letter-spacing: .16em; opacity: .65; pointer-events: none; }\n[data-workspace-area=\"conversation\"] { background: var(--tv-canvas) !important; }\n[data-slot=\"composer-host\"] { background: var(--tv-panel) !important; border: 1px solid var(--tv-border) !important; border-radius: 12px !important; box-shadow: 0 3px 14px var(--tv-shadow) !important; }\n[data-user-message-bubble] { border-radius: 12px !important; }\n[data-thread-details-card], [data-slot=\"settings-group\"] { border: 1px solid var(--tv-border) !important; border-radius: 10px !important; box-shadow: none !important; }\n.chat-markdown a { color: var(--tv-link); text-underline-offset: 3px; }\n@media (max-width: 800px) { [data-chat-header]::after { display: none; } }\n"
