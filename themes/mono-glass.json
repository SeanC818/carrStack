55,255,255,0.05) !important;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.07);\n}\n[data-sidebar-row][aria-current=\"page\"] {\n  background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.05)) !important;\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  box-shadow:\n    inset 0 0 0 1px rgba(255,255,255,0.12),\n    inset 0 1px 0 rgba(255,255,255,0.14),\n    0 4px 16px rgba(0,0,0,0.25) !important;\n}\n\n/* Header: same frosted glass as the sidebar */\n[data-chat-header] {\n  background-image:\n    linear-gradient(172deg, rgba(255,255,255,0.14) 0%, rgba(255,255,255,0.06) 30%, rgba(255,255,255,0.035) 65%, rgba(255,255,255,0.07) 100%),\n    var(--mg-wall) !important;\n  background-attachment: scroll, fixed, fixed, fixed, fixed, fixed !important;\n  background-size: 100% 100%, cover, cover, cover, cover, auto 88vh !important;\n  background-position: 0 0, center, center, center, center, right 2% bottom 0 !important;\n  box-shadow:\n    inset 0 1px 0 rgba(255,255,255,0.16),\n    inset 1px 0 0 rgba(255,255,255,0.04),\n    inset -1px 0 0 rgba(255,255,255,0.05),\n    0 8px 32px rgba(0,0,0,0.35) !important;\n  backdrop-filter: blur(40px) saturate(130%);\n  -webkit-backdrop-filter: blur(40px) saturate(130%);\n  border-bottom: 1px solid rgba(255,255,255,0.18) !important;\n  z-index: 2;\n}\n\n/* Your messages: clear glass, monospace like a neovim buffer */\n[data-user-message-bubble] {\n  background: rgba(255,255,255,0.09) !important;\n  backdrop-filter: blur(28px) saturate(115%);\n  -webkit-backdrop-filter: blur(28px) saturate(115%);\n  border: 1px solid rgba(255,255,255,0.10) !important;\n  box-shadow: 0 4px 24px rgba(0,0,0,0.30), inset 0 1px 0 rgba(255,255,255,0.06);\n  font-family: \"JetBrains Mono\", \"SF Mono\", Menlo, monospace;\n  font-size: 0.92em;\n}\n\n/* Code blocks: darker glass */\n.chat-markdown-codeblock {\n  background: rgba(10,10,12,0.60) !important;\n  backdrop-filter: blur(24px);\n  -webkit-backdrop-filter: blur(24px);\n  border: 1px solid rgba(255,255,255,0.07) !important;\n}\n\n/* Composer: floating glass card, brighter edge on focus */\n[data-slot=\"composer-host\"] {\n  background: rgba(34,34,38,0.55) !important;\n  backdrop-filter: blur(36px) saturate(115%);\n  -webkit-backdrop-filter: blur(36px) saturate(115%);\n  border: 1px solid rgba(255,255,255,0.08) !important;\n  box-shadow: 0 8px 32px rgba(0,0,0,0.40), inset 0 1px 0 rgba(255,255,255,0.05);\n  transition: box-shadow .2s, border-color .2s;\n}\n[data-slot=\"composer-host\"]:focus-within {\n  border-color: rgba(255,255,255,0.22) !important;\n  box-shadow: 0 8px 32px rgba(0,0,0,0.40), 0 0 24px rgba(255,255,255,0.05);\n}\n.composer-tiptap { font-family: \"JetBrains Mono\", \"SF Mono\", Menlo, monospace; }\n\n/* Popups: frosted */\n[data-slot=\"menu-popup\"], [data-slot=\"popover-popup\"], [data-slot=\"dialog-popup\"], [data-slot=\"tooltip-popup\"] {\n  background: rgba(20,20,23,0.78) !important;\n  backdrop-filter: blur(36px) saturate(115%);\n  -webkit-backdrop-filter: blur(36px) saturate(115%);\n  border: 1px solid rgba(255,255,255,0.08) !important;\n}\n\n/* Thin grey scrollbars */\n::-webkit-scrollbar { width: 8px; height: 8px; }\n::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 8px; }\n::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.22); }\n[data-slot=\"scroll-area-thumb\"] { background: rgba(255,255,255,0.16) !important; }\n\nsvg.lucide { stroke-width: 1.75; }\n\n/* Whole-app frost: settings, details, terminal, inputs */\n[data-settings-page-scroll] > * {\n  background: transparent !important;\n}\n[data-thread-details-card] {\n  background: rgba(255,255,255,0.05) !important;\n  backdrop-filter: blur(32px) saturate(115%);\n  -webkit-backdrop-filter: blur(32px) saturate(115%);\n  border: 1px solid rgba(255,255,255,0.08) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);\n}\n[data-slot=\"input\"], [data-slot=\"select-trigger\"] {\n  background: rgba(255,255,255,0.05) !important;\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border-color: rgba(255,255,255,0.10) !important;\n}\n\n/* Sidebar search: glass pill, glass hover and focus */\n[data-slot=\"sidebar\"] div:is(:has(> input[aria-label=\"Search threads\"]), :has(> * > input[aria-label=\"Search threads\"])) {\n  background: rgba(255,255,255,0.04) !important;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08), inset 0 1px 0 rgba(255,255,255,0.06) !important;\n  transition: background-color .15s, box-shadow .15s;\n}\n[data-slot=\"sidebar\"] div:is(:has(> input[aria-label=\"Search threads\"]), :has(> * > input[aria-label=\"Search threads\"])):hover, [data-slot=\"sidebar\"] div:is(:has(> input[aria-label=\"Search threads\"]), :has(> * > input[aria-label=\"Search threads\"])):focus-within {\n  background: rgba(255,255,255,0.09) !important;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18), inset 0 1px 0 rgba(255,255,255,0.12) !important;\n}\n[data-slot=\"sidebar\"] input[aria-label=\"Search threads\"],\n[data-slot=\"sidebar\"] :has(> input[aria-label=\"Search threads\"]):not(div) {\n  background: transparent !important;\n  box-shadow: none !important;\n  border-color: transparent !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n  -webkit-appearance: none;\n  appearance: none;\n}\n\n/* Settings: glass cards over the wallpaper */\n[data-slot=\"settings-group\"] {\n  background: linear-gradient(160deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03)) !important;\n  backdrop-filter: blur(36px) saturate(120%);\n  -webkit-backdrop-filter: blur(36px) saturate(120%);\n  border: 1px solid rgba(255,255,255,0.12) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 8px 32px rgba(0,0,0,0.30) !important;\n}\n[data-slot=\"settings-group\"] > [data-slot=\"settings-row\"] {\n  background: transparent !important;\n  border-color: rgba(255,255,255,0.07) !important;\n}\n[data-slot=\"settings-group\"] > [data-slot=\"settings-row\"]:hover {\n  background: rgba(255,255,255,0.03) !important;\n}\n\n/* Settings menu: same glass sheet as the app sidebar */\n:has(> [data-workspace-area=\"settings\"]) > nav {\n  box-shadow:\n    inset 0 0 0 100vmax rgba(255,255,255,0.05),\n    inset 0 1px 0 rgba(255,255,255,0.14),\n    inset -1px 0 0 rgba(255,255,255,0.14) !important;\n  border-right: 0 !important;\n}\n:has(> [data-workspace-area=\"settings\"]) > nav * {\n  background-color: transparent;\n}\n:has(> [data-workspace-area=\"settings\"]) > nav [aria-current=\"page\"] {\n  background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.05)) !important;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12), inset 0 1px 0 rgba(255,255,255,0.14) !important;\n}\n\n/* Settings top bar: glass band like the chat header */\n[data-workspace-area=\"settings\"] > header {\n  box-shadow:\n    inset 0 0 0 100vmax rgba(255,255,255,0.03),\n    inset 0 44px 40px -20px rgba(255,255,255,0.07),\n    inset 0 1px 0 rgba(255,255,255,0.14),\n    inset 0 -1px 0 rgba(255,255,255,0.18),\n    0 8px 28px rgba(0,0,0,0.38) !important;\n  border-bottom: 0 !important;\n  position: relative;\n  z-index: 2;\n}\n\n/* Switches: monochrome, no pink */\n[data-slot=\"switch\"][data-checked] {\n  background: rgba(228,228,231,0.85) !important;\n  box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 0 12px rgba(255,255,255,0.10);\n}\n[data-slot=\"switch\"][data-unchecked] {\n  background: rgba(255,255,255,0.10) !important;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.10);\n}\n[data-slot=\"switch\"][data-checked] [data-slot=\"switch-thumb\"] {\n  background: #0c0c0e !important;\n}\n\n/* Settings menu search: same glass pill as the sidebar search */\n:has(> [data-workspace-area=\"settings\"]) > nav div:has(> * > input):not(:has(> input)) {\n  background: rgba(255,255,255,0.04) !important;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08), inset 0 1px 0 rgba(255,255,255,0.06) !important;\n  border-radius: 6px;\n}\n:has(> [data-workspace-area=\"settings\"]) > nav div:has(> * > input):not(:has(> input)):hover, :has(> [data-workspace-area=\"settings\"]) > nav div:has(> * > input):not(:has(> input)):focus-within {\n  background: rgba(255,255,255,0.09) !important;\n  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18), inset 0 1px 0 rgba(255,255,255,0.12) !important;\n}\n:has(> [data-workspace-area=\"settings\"]) > nav input, :has(> [data-workspace-area=\"settings\"]) > nav :has(> input) {\n  background: transparent !important;\n  box-shadow: none !important;\n  border-color: transparent !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n  -webkit-appearance: none;\n  appearance: none;\n}\n\n/* Right surface panel: same glass as the terminal drawer */\n[data-workspace-area=\"panel\"] {\n  box-shadow:\n    inset 0 0 0 100vmax rgba(10,8,18,0.55),\n    inset 0 0 0 100vmax rgba(255,255,255,0.04),\n    inset 40px 0 40px -24px rgba(255,255,255,0.06),\n    inset 1px 0 0 rgba(255,255,255,0.22),\n    -8px 0 28px rgba(0,0,0,0.35) !important;\n  border-left: 1px solid rgba(255,255,255,0.18) !important;\n}\n[data-workspace-area=\"panel\"] > *,\n[data-workspace-area=\"panel\"] > * > * {\n  background-color: transparent !important;\n}\n\n/* Terminal drawer: frosted glass, wallpaper behind. Ghostty paints a solid canvas,\n   so it is painted pure black and screen-blended: black drops out, text stays. */\n[data-thread-terminal-drawer] {\n  box-shadow:\n    inset 0 0 0 100vmax rgba(10,8,18,0.55),\n    inset 0 0 0 100vmax rgba(255,255,255,0.04),\n    inset 0 40px 40px -24px rgba(255,255,255,0.06),\n    inset 0 1px 0 rgba(255,255,255,0.22),\n    0 -8px 28px rgba(0,0,0,0.35) !important;\n  border-top: 1px solid rgba(255,255,255,0.18) !important;\n}\n[data-thread-terminal-drawer] * {\n  background-color: transparent !important;\n}\n[data-thread-terminal-drawer] canvas {\n  mix-blend-mode: screen !important;\n}\n"
